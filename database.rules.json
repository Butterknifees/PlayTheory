{
  "rules": {
    "matches": {
      "$id": {
        ".read": "auth != null && $id.matches(/^[a-z0-9]{12}$/)",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid || data.child('guest').val() === auth.uid)",
        ".validate": "$id.matches(/^[a-z0-9]{12}$/) && newData.hasChildren(['host', 'seq', 'snap'])",
        "guest": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
        },
        "snap": {
          ".validate": "newData.isString() && newData.val().length < 500000"
        },
        "seq": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "codes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.child('host').val() === auth.uid",
        ".validate": "$code.matches(/^[A-Z2-9]{5}$/) && newData.child('m').isString() && newData.child('m').val().matches(/^[a-z0-9]{12}$/)"
      }
    }
  }
}
