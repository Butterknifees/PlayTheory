{
  "rules": {
    "matches": {
      "$id": {
        ".read": "auth != null && $id.matches(/^[a-z0-9]{12}$/) && (!data.exists() || !data.child('guest').exists() || data.child('host').val() === auth.uid || data.child('guest').val() === auth.uid)",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || (newData.exists() && (data.child('host').val() === auth.uid || data.child('guest').val() === auth.uid)))",
        ".validate": "$id.matches(/^[a-z0-9]{12}$/) && newData.hasChildren(['host', 'seq', 'snap']) && (!data.exists() || (newData.child('host').val() === data.child('host').val() && (!data.child('guest').exists() || newData.child('guest').val() === data.child('guest').val())))",
        "host": {
          ".validate": "newData.isString() && (data.exists() ? newData.val() === data.val() : newData.val() === auth.uid)"
        },
        "guest": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid",
          ".validate": "newData.isString() && (data.exists() ? newData.val() === data.val() : newData.val() === auth.uid)"
        },
        "seq": {
          ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() + 1 : newData.val() === 1)"
        },
        "snap": {
          ".validate": "newData.isString() && newData.val().length < 200000"
        },
        "by": {
          ".validate": "newData.val() === (newData.parent().child('host').val() === auth.uid ? 0 : 1)"
        },
        "kind": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "tok": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "v": {
          ".validate": "newData.isNumber()"
        },
        "created": {
          ".validate": "newData.isNumber()"
        },
        "code": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Z2-9]{5}$/)"
        },
        "names": {
          "$side": {
            ".validate": "newData.isString() && newData.val().length <= 40 && (newData.val() === data.val() || ($side === 'L' && newData.parent().parent().child('host').val() === auth.uid) || ($side === 'R' && newData.parent().parent().child('guest').val() === auth.uid))"
          }
        },
        "online": {
          "$side": {
            ".validate": "newData.isBoolean() && (newData.val() === data.val() || ($side === 'L' && newData.parent().parent().child('host').val() === auth.uid) || ($side === 'R' && newData.parent().parent().child('guest').val() === auth.uid))"
          }
        },
        "elo": {
          "$side": {
            ".validate": "newData.hasChildren(['rapid', 'turns']) && ((newData.child('rapid').val() === data.child('rapid').val() && newData.child('turns').val() === data.child('turns').val()) || (($side === 'L' && newData.parent().parent().child('host').val() === auth.uid) || ($side === 'R' && newData.parent().parent().child('guest').val() === auth.uid)))",
            "rapid": {
              ".validate": "newData.isNumber() && newData.val() >= 100 && newData.val() <= 4000"
            },
            "turns": {
              ".validate": "newData.isNumber() && newData.val() >= 100 && newData.val() <= 4000"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "logs": {
      "$id": {
        "$seq": {
          ".write": "auth != null && !data.exists() && (root.child('matches').child($id).child('host').val() === auth.uid || root.child('matches').child($id).child('guest').val() === auth.uid)",
          ".validate": "$id.matches(/^[a-z0-9]{12}$/) && $seq.matches(/^[0-9]{1,6}$/) && newData.hasChildren(['k', 'b', 'g', 's', 't'])",
          "k": {
            ".validate": "newData.isString() && newData.val().length <= 12"
          },
          "b": {
            ".validate": "newData.val() === (root.child('matches').child($id).child('host').val() === auth.uid ? 0 : 1)"
          },
          "g": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "s": {
            ".validate": "newData.isString() && newData.val().length < 20000"
          },
          "t": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "codes": {
      "$code": {
        ".read": "auth != null && data.child('at').val() > now - 86400000 && !root.child('matches').child(data.child('m').val()).child('guest').exists()",
        ".write": "auth != null && ((newData.child('host').val() === auth.uid && (!data.exists() || data.child('at').val() <= now - 86400000)) || (!newData.exists() && data.child('host').val() === auth.uid))",
        ".validate": "$code.matches(/^[A-Z2-9]{5}$/) && newData.hasChildren(['m', 'host', 'at']) && newData.child('m').isString() && newData.child('m').val().matches(/^[a-z0-9]{12}$/) && root.child('matches').child(newData.child('m').val()).child('host').val() === auth.uid && newData.child('at').val() === now",
        "m": {
          ".validate": "newData.isString()"
        },
        "host": {
          ".validate": "newData.isString()"
        },
        "at": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "daily": {
      "$day": {
        ".read": "auth != null && $day.matches(/^20[0-9]{2}-[01][0-9]-[0-3][0-9]$/)",
        ".indexOn": [
          "total"
        ],
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous' && !data.exists() && newData.exists()",
          ".validate": "$day.matches(/^20[0-9]{2}-[01][0-9]-[0-3][0-9]$/) && newData.hasChildren(['a', 'b', 'sa', 'sb', 'ms', 'wrong', 'total', 'at'])",
          "a": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
          },
          "b": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
          },
          "sa": {
            ".validate": "newData.isNumber() && newData.val() >= -1000 && newData.val() <= 10000"
          },
          "sb": {
            ".validate": "newData.isNumber() && newData.val() >= -1000 && newData.val() <= 10000"
          },
          "ms": {
            ".validate": "newData.isNumber() && newData.val() >= 30000 && newData.val() <= 86400000"
          },
          "wrong": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000 && newData.val() % 1 === 0"
          },
          "total": {
            ".validate": "newData.isNumber() && newData.val() === newData.parent().child('ms').val() + newData.parent().child('wrong').val() * 10000"
          },
          "at": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "ratings": {
      "$pool": {
        ".read": "auth != null && ($pool === 'rapid' || $pool === 'turns')",
        ".indexOn": [
          "r"
        ],
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous' && newData.exists()",
          ".validate": "($pool === 'rapid' || $pool === 'turns') && newData.hasChildren(['r', 'n', 'w', 'l', 'd', 'name', 'opp', 'm', 'g', 'at']) && (!data.exists() || data.child('at').val() < now - 30000) && newData.child('w').val() + newData.child('l').val() + newData.child('d').val() === newData.child('n').val() && !root.child('rated').child(newData.child('m').val()).child(newData.child('g').val()).child($uid).exists() && newData.parent().parent().parent().child('rated').child(newData.child('m').val()).child(newData.child('g').val()).child($uid).exists()",
          "r": {
            ".validate": "newData.isNumber() && newData.val() >= 100 && newData.val() <= 4000 && (data.exists() ? (newData.val() - data.val() <= 40 && data.val() - newData.val() <= 40) : (newData.val() - 1200 <= 40 && 1200 - newData.val() <= 40))"
          },
          "n": {
            ".validate": "newData.val() === (data.exists() ? data.val() + 1 : 1)"
          },
          "w": {
            ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 1"
          },
          "l": {
            ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 1"
          },
          "d": {
            ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 1"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
          },
          "m": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{12}$/) && root.child('matches').child(newData.val()).child('guest').exists() && (root.child('matches').child(newData.val()).child('host').val() === auth.uid || root.child('matches').child(newData.val()).child('guest').val() === auth.uid)"
          },
          "opp": {
            ".validate": "newData.isString() && newData.val() !== auth.uid && root.child('users').child(newData.val()).exists() && (root.child('matches').child(newData.parent().child('m').val()).child('host').val() === newData.val() || root.child('matches').child(newData.parent().child('m').val()).child('guest').val() === newData.val())"
          },
          "g": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{6,12}$/)"
          },
          "at": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "rated": {
      "$m": {
        "$g": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists()",
            ".validate": "$m.matches(/^[a-z0-9]{12}$/) && $g.matches(/^[a-z0-9]{6,12}$/) && newData.hasChildren(['r0', 'r1', 'at'])",
            "r0": {
              ".validate": "newData.isNumber() && newData.val() >= 100 && newData.val() <= 4000"
            },
            "r1": {
              ".validate": "newData.isNumber() && newData.val() >= 100 && newData.val() <= 4000"
            },
            "at": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "since": {
          ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() === now)"
        },
        "seen": {
          ".validate": "newData.val() === now"
        },
        "stats": {
          "$game": {
            ".validate": "$game.matches(/^[a-z0-9]{1,20}$/)",
            "played": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "wins": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "losses": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "draws": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "last": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
